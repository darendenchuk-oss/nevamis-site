    {
      "shot": "C02",
      "tin": 2.6,
      "tout": 8.3,
      "vk": "A",
      "voice": "James",
      "text": "You built the business for freedom. Then running it started taking all of yours.",
      "room": 5.7,
      "spoken": 4.86,
      "lufs": -23,
      "cue": 2.6
    },
    {
      "shot": "C03",
      "tin": 8.3,
      "tout": 14,
      "vk": "B",
      "voice": "Cassidy",
      "text": "Calls arrive while your hands are full. Miss one, and the job can be gone.",
      "room": 5.7,
      "spoken": 4.25,
      "lufs": -23,
      "cue": 7.709
    },
    {
      "shot": "C05",
      "tin": 15.5,
      "tout": 20.2,
      "vk": "C",
      "voice": "Michael C. Vincent",
      "text": "NEVAMIS starts there. Calls answered. Opportunities captured, day or night.",
      "room": 4.7,
      "spoken": 5.13,
      "lufs": -23.5,
      "cue": 13.459
    },
    {
      "shot": "C06",
      "tin": 20.2,
      "tout": 24.7,
      "vk": "D",
      "voice": "Jessica Anne Bogart",
      "text": "Who they are. What they need. Where, when, and how urgent.",
      "room": 4.5,
      "spoken": 4.34,
      "lufs": -23,
      "cue": 18.837
    },
    {
      "shot": "C07",
      "tin": 24.7,
      "tout": 29.6,
      "vk": "A",
      "voice": "James",
      "text": "It follows your rules. It never guesses. Important decisions come back to you.",
      "room": 4.9,
      "spoken": 6.81,
      "lufs": -22.9,
      "cue": 23.426
    },
    {
      "shot": "C08",
      "tin": 29.6,
      "tout": 33.5,
      "vk": "B",
      "voice": "Cassidy",
      "text": "The job is captured. The next move is clear.",
      "room": 3.9,
      "spoken": 2.44,
      "lufs": -23,
      "cue": 30.484
    },
    {
      "shot": "C09",
      "tin": 33.5,
      "tout": 40,
      "vk": "C",
      "voice": "Michael C. Vincent",
      "text": "Next, NEVAMIS will connect your company, automate repetitive work, and uncover value between systems.",
      "room": 6.5,
      "spoken": 7.27,
      "lufs": -22.7,
      "cue": 33.173
    },
    {
      "shot": "C10",
      "tin": 40,
      "tout": 44.4,
      "vk": "D",
      "voice": "Jessica Anne Bogart",
      "text": "So growth takes less of your life, not more.",
